# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Any Flash model id. A pinned id behaves the same until you change it;
# the "gemini-flash-latest" alias also works but switches to each new release.
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to 1 to let the assistant call Grounding with Google Maps for place questions.
# Needs billing enabled on the Gemini key's project; the free tier returns 429.
ENABLE_MAPS_GROUNDING=0

# --- Map tiles (optional) ---
# Free CARTO Basemaps key (non-commercial, up to 5M requests/month): https://carto.com/basemaps/apikey/
# With it the map uses CARTO's cleaner style; without it, standard OpenStreetMap tiles.
# Inlined into the browser bundle at build time, so restart `npm run dev` / redeploy after changing it.
NEXT_PUBLIC_CARTO_KEY=

# --- Firebase client (Project settings > Your apps > Web app). Enables anonymous auth. ---
# Set these together with FIREBASE_SERVICE_ACCOUNT below, or leave all of them empty.
# With only the client set, the server rejects every request ("Missing anonymous id").
# Also enable Authentication > Sign-in method > Anonymous in the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server). Paste the service-account JSON on one line. ---
# If unset, the server uses an in-memory store (dev only: data is lost on restart).
FIREBASE_SERVICE_ACCOUNT=

# --- Pilot dashboard passcode (/pilot). Required to read metrics or enter manual counts. ---
PILOT_ADMIN_TOKEN=change-me

# Salt for hashing anonymous user ids before they are stored.
ID_HASH_SALT=change-me-too

# --- Trip check-ins (web push). Generate the pair with `npx web-push generate-vapid-keys`. ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your site URL (or a mailto:) so push services can contact you.
VAPID_SUBJECT=https://ru-parksmart.vercel.app
# Shared secret for /api/cron/checkins (send as "Authorization: Bearer <secret>"). e.g. `openssl rand -hex 32`
CRON_SECRET=
